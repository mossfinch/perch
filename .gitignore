# This file serves both sides: the Perch working repo, and the public package that
# is exported out of it. It is on the shipping manifest, so after export it becomes
# the public repo's root .gitignore.
#
# ⚠️ .gitignore only stops git from TRACKING a file. Keeping something out of the
# public package is a different mechanism entirely: neverCopy and excludedOnPurpose
# in perch-package.json. Do not use one to reason about the other.

# macOS and Python litter. Bytecode can embed absolute paths from this machine.
.DS_Store
__pycache__/
*.pyc

# Local agent session state: can contain absolute paths, executed commands, session ids.
.omc/
**/.omc/

# Xcode user state and build products.
xcuserdata/
DerivedData/
build/
*.zip
